---
const steps = [
	{ n: '01', title: 'Diagnóstico gratuito', desc: 'Entendemos seu momento, suas metas e onde estão as maiores oportunidades de crescimento.' },
	{ n: '02', title: 'Planejamento estratégico', desc: 'Montamos o plano de marketing e tecnologia sob medida para o seu negócio.' },
	{ n: '03', title: 'Execução com especialistas', desc: 'Um time fixo coloca tudo em prática — anúncios, conteúdo, sites e sistemas.' },
	{ n: '04', title: 'Escala e otimização', desc: 'Acompanhamos os números em tempo real e otimizamos continuamente para crescer mais.' },
];
---

<section id="como-funciona" class="border-y border-border/60 bg-surface/30">
	<div class="mx-auto max-w-6xl px-4 py-20">
		<div class="max-w-2xl" data-reveal>
			<h2 class="text-3xl font-bold sm:text-4xl">Um processo claro, do primeiro contato ao crescimento</h2>
			<p class="mt-4 text-muted">Sem caixa-preta. Você acompanha cada etapa e cada resultado.</p>
		</div>

		<ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{
				steps.map((s, i) => (
					<li class="relative rounded-2xl border border-border bg-surface/50 p-6" data-reveal style={`--reveal-delay:${i * 80}ms;`}>
						<span class="text-2xl font-bold text-roxo-light">{s.n}</span>
						<h3 class="mt-3 font-semibold text-text">{s.title}</h3>
						<p class="mt-2 text-sm text-muted">{s.desc}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
