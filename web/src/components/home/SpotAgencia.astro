---
import Button from '../ui/Button.astro';
import { whatsappLink } from '../../config/site';

const features = [
	'Campanhas e resultados atualizados em tempo real',
	'Aprovação de mídias por comentário, sem trocar mil e-mails',
	'Relatórios automáticos — sem planilha, sem enrolação',
	'Acesso 24/7, de qualquer lugar, quando você quiser',
];
---

<section class="border-y border-border/60 bg-surface/30">
	<div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 lg:grid-cols-2">
		<div data-reveal>
			<p class="text-sm font-medium uppercase tracking-[0.15em] text-roxo-light">
				Tecnologia própria · SpotAgência
			</p>
			<h2 class="mt-3 text-3xl font-bold sm:text-4xl">
				Você nunca mais fica no escuro sobre o que a agência está fazendo
			</h2>
			<p class="mt-4 text-muted">
				Enquanto outras agências mandam um print no fim do mês, com a Matra você acompanha
				tudo em tempo real no <strong class="text-text">SpotAgência</strong> — nossa plataforma
				exclusiva de clientes. Demandas, aprovações, campanhas e resultados em um só lugar.
			</p>

			<ul class="mt-6 space-y-3">
				{
					features.map((f) => (
						<li class="flex items-start gap-3">
							<span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-roxo/20 text-roxo-light">
								<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
							</span>
							<span class="text-sm text-text">{f}</span>
						</li>
					))
				}
			</ul>

			<div class="mt-8">
				<Button href={whatsappLink('Olá! Quero conhecer o SpotAgência e como acompanho meus resultados em tempo real.')}>
					Quero acompanhar meus resultados
				</Button>
			</div>
		</div>

		<!-- Mockup do painel -->
		<div class="relative" data-reveal style="--reveal-delay:120ms;">
			<div class="bg-glow absolute -inset-6 -z-10 rounded-3xl opacity-60 blur-2xl"></div>
			<div class="rounded-2xl border border-border bg-surface shadow-2xl">
				<div class="flex items-center gap-2 border-b border-border/60 px-4 py-3">
					<span class="h-2.5 w-2.5 rounded-full bg-red-400/70"></span>
					<span class="h-2.5 w-2.5 rounded-full bg-yellow-400/70"></span>
					<span class="h-2.5 w-2.5 rounded-full bg-green-400/70"></span>
					<span class="ml-3 text-xs text-muted">SpotAgência · Painel do cliente</span>
				</div>
				<div class="space-y-4 p-5">
					<div class="grid grid-cols-3 gap-3">
						<div class="rounded-xl border border-border bg-surface-2 p-3">
							<p class="text-[10px] uppercase tracking-wide text-muted">ROAS</p>
							<p class="mt-1 text-xl font-bold text-roxo-light">4,8×</p>
						</div>
						<div class="rounded-xl border border-border bg-surface-2 p-3">
							<p class="text-[10px] uppercase tracking-wide text-muted">Leads</p>
							<p class="mt-1 text-xl font-bold text-text">312</p>
						</div>
						<div class="rounded-xl border border-border bg-surface-2 p-3">
							<p class="text-[10px] uppercase tracking-wide text-muted">CAC</p>
							<p class="mt-1 text-xl font-bold text-text">-34%</p>
						</div>
					</div>

					<div class="rounded-xl border border-border bg-surface-2 p-4">
						<div class="mb-3 flex items-center justify-between text-xs text-muted">
							<span>Investimento do mês</span><span class="text-text">R$ 18.400</span>
						</div>
						<div class="flex h-16 items-end gap-1.5">
							{[40, 55, 48, 70, 62, 85, 78, 96].map((h) => (
								<span class="flex-1 rounded-t bg-gradient-to-t from-roxo-deep to-roxo-light" style={`height:${h}%`}></span>
							))}
						</div>
					</div>

					<div class="flex items-center justify-between rounded-xl border border-border bg-surface-2 px-4 py-3">
						<div class="flex items-center gap-2 text-xs text-text">
							<span class="flex h-6 w-6 items-center justify-center rounded-full bg-roxo/20 text-roxo-light">
								<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
							</span>
							Criativo "Campanha Julho" aprovado
						</div>
						<span class="text-[10px] text-muted">agora</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
