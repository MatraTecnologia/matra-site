---
import Button from '../ui/Button.astro';
import { whatsappLink } from '../../config/site';

const timeline = [
	{
		when: 'Hoje',
		title: 'Você dá o primeiro passo',
		desc: 'Fala com a gente no WhatsApp e agenda seu diagnóstico estratégico gratuito. Já sai entendendo o potencial da sua empresa.',
	},
	{
		when: 'Primeiros dias',
		title: 'Plano sob medida + acesso ao SpotAgência',
		desc: 'Recebe uma estratégia feita para o seu negócio e passa a acompanhar tudo em tempo real na nossa plataforma exclusiva.',
	},
	{
		when: 'Em ~21 dias',
		title: 'Primeiros resultados no ar',
		desc: 'Suas campanhas começam a rodar e os primeiros leads e vendas aparecem — com tudo medido, sem achismo.',
	},
	{
		when: 'Em 90 dias',
		title: 'Operação previsível e lucrativa',
		desc: 'Custo por cliente menor, conversão maior e um fluxo constante de oportunidades entrando.',
	},
	{
		when: 'Daqui pra frente',
		title: 'Uma máquina de crescimento',
		desc: 'Marketing e tecnologia escalando juntos, mês após mês, enquanto você foca em atender a demanda.',
	},
];
---

<section class="mx-auto max-w-4xl px-4 py-20">
	<div class="mx-auto max-w-2xl text-center" data-reveal>
		<p class="text-sm font-medium uppercase tracking-[0.15em] text-roxo-light">Comece hoje</p>
		<h2 class="mt-3 text-3xl font-bold sm:text-4xl">O que acontece quando você começa agora</h2>
		<p class="mt-4 text-muted">
			Cada dia sem uma estratégia é dinheiro que vai para a concorrência. Veja como sua empresa
			se transforma a partir da primeira conversa.
		</p>
	</div>

	<ol class="relative mt-12 space-y-8 before:absolute before:left-[15px] before:top-2 before:h-[calc(100%-1rem)] before:w-px before:bg-gradient-to-b before:from-roxo before:via-roxo/40 before:to-transparent">
		{
			timeline.map((t, i) => (
				<li class="relative flex gap-6" data-reveal style={`--reveal-delay:${i * 90}ms;`}>
					<span class="relative z-10 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-roxo/40 bg-surface text-sm font-bold text-roxo-light shadow-[0_0_0_4px_rgba(155,7,240,0.08)]">
						{i + 1}
					</span>
					<div class="-mt-0.5 rounded-2xl border border-border bg-surface/40 p-5">
						<span class="text-xs font-medium uppercase tracking-wide text-roxo-light">{t.when}</span>
						<h3 class="mt-1 font-semibold text-text">{t.title}</h3>
						<p class="mt-1.5 text-sm text-muted">{t.desc}</p>
					</div>
				</li>
			))
		}
	</ol>

	<div class="mt-12 text-center" data-reveal>
		<Button href={whatsappLink('Olá! Quero começar hoje com a Matra. Podem me chamar?')} size="lg">
			Quero começar hoje
		</Button>
		<p class="mt-3 text-sm text-muted">Diagnóstico gratuito · Sem compromisso · Resposta em até 24h</p>
	</div>
</section>
