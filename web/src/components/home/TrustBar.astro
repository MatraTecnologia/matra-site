---
const stats = [
	{ value: '21 dias', label: 'até o 1º resultado' },
	{ value: '4,8×', label: 'ROAS médio em anúncios' },
	{ value: '+20', label: 'clientes ativos' },
	{ value: '9', label: 'plataformas próprias' },
];
---

<section class="border-y border-border/60 bg-surface/40">
	<dl class="mx-auto grid max-w-5xl grid-cols-2 gap-8 px-4 py-10 sm:grid-cols-4">
		{
			stats.map((s) => (
				<div class="text-center">
					<dt class="text-3xl font-bold text-metal">{s.value}</dt>
					<dd class="mt-1 text-xs text-muted">{s.label}</dd>
				</div>
			))
		}
	</dl>
</section>
