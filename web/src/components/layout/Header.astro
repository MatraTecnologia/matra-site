---
import Button from '../ui/Button.astro';
import { PILLARS } from '../../config/pillars';
import { SEGMENTOS, FERRAMENTAS } from '../../data/local-seo';
import { CIDADES_CONTENT } from '../../data/local-conteudo';
import { whatsappLink } from '../../config/site';

const grupos = ['Marketing', 'Tecnologia', 'Negócios'] as const;
const cidades = CIDADES_CONTENT.map((c) => ({ nome: c.nome, href: `/marketing-em-${c.slug}` }));
const conteudo = [
	{ nome: 'Blog', href: '/blog' },
	{ nome: 'Guias', href: '/guias' },
	{ nome: 'Casos de Sucesso', href: '/casos' },
	{ nome: 'Glossário', href: '/glossario' },
	{ nome: 'Ferramentas Grátis', href: '/ferramentas' },
];

const link = 'block rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:bg-surface-2 hover:text-roxo-light';
const trigger = 'flex items-center gap-1 text-sm text-muted transition-colors hover:text-text';
const caret = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';
---

<header class="sticky top-0 z-50 border-b border-border/60 bg-bg/80 backdrop-blur-lg">
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-4 sm:px-6">
		<a href="/" class="flex shrink-0 items-center gap-2" aria-label="Matra — início">
			<img src="/logo-escrita.svg" alt="Matra" width="120" height="32" class="h-8 w-auto" fetchpriority="high" />
		</a>

		<!-- Desktop -->
		<nav aria-label="Principal" class="hidden items-center gap-6 lg:flex">
			<!-- Serviços -->
			<div class="group relative">
				<button class={trigger} aria-haspopup="true">Serviços<Fragment set:html={caret} /></button>
				<div class="pointer-events-none absolute left-1/2 top-full -translate-x-1/2 pt-4 opacity-0 transition-opacity duration-150 group-hover:pointer-events-auto group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:opacity-100">
					<div class="w-[620px] rounded-2xl border border-border bg-surface p-5 shadow-2xl">
						<div class="grid grid-cols-3 gap-x-4 gap-y-1">
							{grupos.map((g) => (
								<div>
									<p class="px-3 pb-1 pt-2 text-xs font-semibold uppercase tracking-wide text-roxo-light">{g}</p>
									{PILLARS.filter((p) => p.group === g).map((p) => (
										<a href={`/${p.slug}`} class={link}>{p.name}</a>
									))}
								</div>
							))}
						</div>
						<a href="/servicos" class="mt-3 block border-t border-border/60 px-3 pt-3 text-sm font-medium text-roxo-light hover:underline">Ver todos os serviços →</a>
					</div>
				</div>
			</div>

			<!-- Segmentos -->
			<div class="group relative">
				<button class={trigger} aria-haspopup="true">Segmentos<Fragment set:html={caret} /></button>
				<div class="pointer-events-none absolute left-1/2 top-full -translate-x-1/2 pt-4 opacity-0 transition-opacity duration-150 group-hover:pointer-events-auto group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:opacity-100">
					<div class="w-[560px] rounded-2xl border border-border bg-surface p-5 shadow-2xl">
						<div class="grid grid-cols-3 gap-x-4 gap-y-0.5">
							{SEGMENTOS.map((s) => <a href={s.href} class={link}>{s.nome}</a>)}
						</div>
					</div>
				</div>
			</div>

			<!-- Onde atuamos -->
			<div class="group relative">
				<button class={trigger} aria-haspopup="true">Onde atuamos<Fragment set:html={caret} /></button>
				<div class="pointer-events-none absolute left-1/2 top-full -translate-x-1/2 pt-4 opacity-0 transition-opacity duration-150 group-hover:pointer-events-auto group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:opacity-100">
					<div class="w-[420px] rounded-2xl border border-border bg-surface p-5 shadow-2xl">
						<div class="grid grid-cols-2 gap-x-4 gap-y-0.5">
							{cidades.map((c) => <a href={c.href} class={link}>{c.nome}</a>)}
						</div>
						<a href="/onde-atuamos" class="mt-3 block border-t border-border/60 px-3 pt-3 text-sm font-medium text-roxo-light hover:underline">Todas as regiões →</a>
					</div>
				</div>
			</div>

			<!-- Conteúdo -->
			<div class="group relative">
				<button class={trigger} aria-haspopup="true">Conteúdo<Fragment set:html={caret} /></button>
				<div class="pointer-events-none absolute left-1/2 top-full -translate-x-1/2 pt-4 opacity-0 transition-opacity duration-150 group-hover:pointer-events-auto group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:opacity-100">
					<div class="w-[240px] rounded-2xl border border-border bg-surface p-3 shadow-2xl">
						{conteudo.map((c) => <a href={c.href} class={link}>{c.nome}</a>)}
					</div>
				</div>
			</div>

			<a href="/sobre" class={trigger}>Sobre</a>
		</nav>

		<div class="flex items-center gap-3">
			<Button href={whatsappLink('Olá! Vim pelo site da Matra.')} size="md" class="hidden sm:inline-flex">
				Falar no WhatsApp
			</Button>

			<!-- Mobile toggle (details = zero JS) -->
			<details class="mobile-menu lg:hidden">
				<summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-border text-text">
					<svg class="menu-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
					<svg class="menu-close hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
				</summary>
				<div class="fixed inset-x-0 bottom-0 top-16 z-40 overflow-y-auto border-t border-border bg-bg px-4 py-5">
					<nav aria-label="Menu" class="space-y-2">
						<details class="rounded-xl border border-border">
							<summary class="cursor-pointer px-4 py-3 font-medium text-text">Serviços</summary>
							<div class="grid grid-cols-1 gap-0.5 px-2 pb-3">
								{PILLARS.map((p) => <a href={`/${p.slug}`} class={link}>{p.name}</a>)}
								<a href="/servicos" class="px-3 py-2 text-sm font-medium text-roxo-light">Ver todos →</a>
							</div>
						</details>
						<details class="rounded-xl border border-border">
							<summary class="cursor-pointer px-4 py-3 font-medium text-text">Segmentos</summary>
							<div class="grid grid-cols-1 gap-0.5 px-2 pb-3">
								{SEGMENTOS.map((s) => <a href={s.href} class={link}>{s.nome}</a>)}
							</div>
						</details>
						<details class="rounded-xl border border-border">
							<summary class="cursor-pointer px-4 py-3 font-medium text-text">Onde atuamos</summary>
							<div class="grid grid-cols-2 gap-0.5 px-2 pb-3">
								{cidades.map((c) => <a href={c.href} class={link}>{c.nome}</a>)}
								<a href="/onde-atuamos" class="px-3 py-2 text-sm font-medium text-roxo-light">Todas →</a>
							</div>
						</details>
						<details class="rounded-xl border border-border">
							<summary class="cursor-pointer px-4 py-3 font-medium text-text">Conteúdo</summary>
							<div class="grid grid-cols-1 gap-0.5 px-2 pb-3">
								{conteudo.map((c) => <a href={c.href} class={link}>{c.nome}</a>)}
							</div>
						</details>
						<a href="/sobre" class="block rounded-xl border border-border px-4 py-3 font-medium text-text">Sobre</a>
						<a href="/contato" class="block rounded-xl border border-border px-4 py-3 font-medium text-text">Contato</a>
						<Button href={whatsappLink('Olá! Vim pelo site da Matra.')} class="mt-2 w-full">Falar no WhatsApp</Button>
					</nav>
				</div>
			</details>
		</div>
	</div>
</header>

<style>
	.mobile-menu[open] .menu-open { display: none; }
	.mobile-menu[open] .menu-close { display: block; }
</style>

<script is:inline>
	// Fecha o menu mobile ao navegar (View Transitions) e trava o scroll com ele aberto
	const initMenu = () => {
		document.querySelectorAll('.mobile-menu').forEach((m) => {
			m.addEventListener('toggle', () => {
				document.body.style.overflow = m.open ? 'hidden' : '';
			});
		});
	};
	initMenu();
	document.addEventListener('astro:page-load', () => {
		document.body.style.overflow = '';
		initMenu();
	});
</script>
