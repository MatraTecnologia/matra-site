---
import JsonLd from './JsonLd.astro';
import { breadcrumbSchema } from '../../lib/schema';

interface Props {
	items: { name: string; url: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm text-muted">
	<ol class="flex flex-wrap items-center gap-2">
		{
			items.map((it, i) => (
				<li class="flex items-center gap-2">
					{i > 0 && <span aria-hidden="true" class="text-border">/</span>}
					{i < items.length - 1 ? (
						<a href={it.url} class="hover:text-roxo-light transition-colors">
							{it.name}
						</a>
					) : (
						<span aria-current="page" class="text-text">{it.name}</span>
					)}
				</li>
			))
		}
	</ol>
</nav>

<JsonLd schema={{ '@context': 'https://schema.org', ...breadcrumbSchema(items) }} />
