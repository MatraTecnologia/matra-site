---
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppFloat from '../components/layout/WhatsAppFloat.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { graph, organizationSchema, websiteSchema } from '../lib/schema';

interface Props {
	title: string;
	description: string;
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	noindex?: boolean;
	class?: string;
}

const { class: mainClass = '', ...head } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead {...head} />
		<JsonLd schema={graph(organizationSchema(), websiteSchema())} />
		<ClientRouter />
	</head>
	<body>
		<a
			href="#conteudo"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-roxo focus:px-4 focus:py-2 focus:text-white"
		>
			Pular para o conteúdo
		</a>
		<Header />
		<main id="conteudo" class={mainClass}>
			<slot />
		</main>
		<Footer />
		<WhatsAppFloat />

		<script is:inline>
			const initReveal = () => {
				const els = document.querySelectorAll('[data-reveal]:not(.is-visible)');
				if (!els.length) return;
				const io = new IntersectionObserver(
					(entries, obs) => {
						for (const e of entries) {
							if (e.isIntersecting) {
								e.target.classList.add('is-visible');
								obs.unobserve(e.target);
							}
						}
					},
					{ rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
				);
				els.forEach((el) => io.observe(el));
			};
			initReveal();
			document.addEventListener('astro:page-load', initReveal);
		</script>
	</body>
</html>
